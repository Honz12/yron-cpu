%org 0x0000                     ; boot section

jmp main

%org 0x0200                     ; interrupt table section

%dword 0
%dword device_init_interrupt
%dword device_input_interrupt

%org 0x0400                     ; code section

%include "lib/stdio.yrn"

welcome_message:
    %asciz "Hello world\n"            ; welcome message

main:
    ldid $10, welcome_message
    call lib_puts
.loop:
    call lib_getc
    call lib_putc
    
    jmp .loop

halt:
    jmp halt
