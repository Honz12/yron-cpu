%org 0x0000                     ; boot section

jmp main

%include "lib/.yrn"

%org 0x0200                     ; interrupt table section

%dword 0
%dword device_init_interrupt

%org 0x0400                     ; code section

main:
    ldib $10, 'A'
    call lib_display_device_putc

    ldib $10, 'H'
    call lib_display_device_putc

    ldib $10, 'O'
    call lib_display_device_putc

    ldib $10, 'J'
    call lib_display_device_putc
    
    jmp halt

halt:
    jmp halt
