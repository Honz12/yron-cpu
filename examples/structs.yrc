// structs.yrc
// Exercises structs, pointers, arrow access, arrays of structs and nested calls.
// Returns 20 in $0F: (1*2) + (2*3) + (3*4).

struct Point
{
    u32 x;
    u32 y;
};

u32 area(struct Point* p)
{
    return (*p).x * p->y;
}

u32 main()
{
    struct Point pts[3];
    struct Point* p;
    u32 i;
    u32 total;

    for (i = 0; i < 3; i = i + 1)
    {
        pts[i].x = i + 1;
        pts[i].y = i + 2;
    }

    total = 0;
    for (i = 0; i < 3; i = i + 1)
    {
        p = &pts[i];
        total = total + area(p);
    }

    return total;
}
